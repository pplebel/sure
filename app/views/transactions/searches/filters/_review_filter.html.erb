<%= form.label :review_status, "Review status", class: "text-sm text-primary" %>
<%= form.select :review_status, [["All transactions", ""], ["Needs review", "unreviewed"], ["Reviewed", "reviewed"]], {selected: @q[:review_status]}, class: "form-field__input" %>
<p class="text-xs text-secondary mt-2">A category or bank confirmation does not mean you personally reviewed the transaction.</p>
